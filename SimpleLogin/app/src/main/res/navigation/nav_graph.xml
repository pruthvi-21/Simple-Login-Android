<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_nav_graph"
    app:startDestination="@id/aliasListFragment">

    <fragment
        android:id="@+id/aliasListFragment"
        android:name="io.simplelogin.android.module.alias.AliasListFragment"
        android:label="AliasListFragment">
        <action
            android:id="@+id/action_aliasFragment_to_contactListFragment"
            app:destination="@id/contactListFragment"
            app:enterAnim="@anim/screen_enter_anim"
            app:exitAnim="@anim/screen_exit_anim"
            app:popEnterAnim="@anim/screen_pop_enter_anim"
            app:popExitAnim="@anim/screen_pop_exit_anim" />
        <action
            android:id="@+id/action_aliasListFragment_to_aliasActivityListFragment"
            app:destination="@id/aliasActivityListFragment"
            app:enterAnim="@anim/screen_enter_anim"
            app:exitAnim="@anim/screen_exit_anim"
            app:popEnterAnim="@anim/screen_pop_enter_anim"
            app:popExitAnim="@anim/screen_pop_exit_anim" />
        <action
            android:id="@+id/action_aliasListFragment_to_aliasSearchFragment"
            app:destination="@id/aliasSearchFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim">
            <argument
                android:name="searchMode"
                app:argType="io.simplelogin.android.module.alias.search.AliasSearchMode" />
        </action>
        <action
            android:id="@+id/action_aliasListFragment_to_aliasCreateFragment"
            app:destination="@id/aliasCreateFragment"
            app:enterAnim="@anim/screen_enter_anim"
            app:exitAnim="@anim/screen_exit_anim"
            app:popEnterAnim="@anim/screen_pop_enter_anim"
            app:popExitAnim="@anim/screen_pop_exit_anim" />
        <action
            android:id="@+id/action_aliasListFragment_to_webViewFragment"
            app:destination="@id/webViewFragment"
            app:enterAnim="@anim/screen_enter_anim"
            app:exitAnim="@anim/screen_exit_anim"
            app:popEnterAnim="@anim/screen_pop_enter_anim"
            app:popExitAnim="@anim/screen_pop_exit_anim" />
        <action
            android:id="@+id/action_aliasListFragment_to_aliasPickerFragment"
            app:destination="@id/aliasPickerFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>
    <fragment
        android:id="@+id/contactListFragment"
        android:name="io.simplelogin.android.module.alias.contact.ContactListFragment"
        android:label="ContactListFragment">
        <argument
            android:name="alias"
            app:argType="io.simplelogin.android.utils.model.Alias" />
    </fragment>
    <fragment
        android:id="@+id/aliasActivityListFragment"
        android:name="io.simplelogin.android.module.alias.activity.AliasActivityListFragment"
        android:label="AliasActivityListFragment">
        <argument
            android:name="alias"
            app:argType="io.simplelogin.android.utils.model.Alias" />
    </fragment>
    <fragment
        android:id="@+id/aliasSearchFragment"
        android:name="io.simplelogin.android.module.alias.search.AliasSearchFragment"
        android:label="AliasSearchFragment">
        <action
            android:id="@+id/action_aliasSearchFragment_to_contactListFragment"
            app:destination="@id/contactListFragment"
            app:enterAnim="@anim/screen_enter_anim"
            app:exitAnim="@anim/screen_exit_anim"
            app:popEnterAnim="@anim/screen_pop_enter_anim"
            app:popExitAnim="@anim/screen_pop_exit_anim" />
        <action
            android:id="@+id/action_aliasSearchFragment_to_aliasActivityListFragment"
            app:destination="@id/aliasActivityListFragment"
            app:enterAnim="@anim/screen_enter_anim"
            app:exitAnim="@anim/screen_exit_anim"
            app:popEnterAnim="@anim/screen_pop_enter_anim"
            app:popExitAnim="@anim/screen_pop_exit_anim" />
        <argument
            android:name="searchMode"
            app:argType="io.simplelogin.android.module.alias.search.AliasSearchMode" />
    </fragment>
    <fragment
        android:id="@+id/aliasCreateFragment"
        android:name="io.simplelogin.android.module.alias.create.AliasCreateFragment"
        android:label="AliasCreateFragment">
        <argument
            android:name="isMailFromAlias"
            app:argType="boolean" />
    </fragment>
    <fragment
        android:id="@+id/webViewFragment"
        android:name="io.simplelogin.android.module.about.WebViewFragment"
        android:label="WebViewFragment">
        <argument
            android:name="url"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/aliasPickerFragment"
        android:name="io.simplelogin.android.module.alias.picker.AliasPickerFragment"
        android:label="AliasPickerFragment">
        <action
            android:id="@+id/action_aliasPickerFragment_to_aliasSearchFragment"
            app:destination="@id/aliasSearchFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim">
            <argument
                android:name="searchMode"
                app:argType="io.simplelogin.android.module.alias.search.AliasSearchMode" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/mailboxListFragment"
        android:name="io.simplelogin.android.module.mailbox.MailboxListFragment"
        android:label="MailboxListFragment" />

    <!--start:Settings fragments-->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="io.simplelogin.android.module.settings.SettingsFragment"
        android:label="SettingsFragment">
        <argument
            android:name="userInfo"
            app:argType="io.simplelogin.android.utils.model.UserInfo"
            app:nullable="false" />
        <action
            android:id="@+id/action_settingsFragment_to_premiumFragment"
            app:destination="@id/premiumFragment"
            app:enterAnim="@anim/screen_enter_anim"
            app:exitAnim="@anim/screen_exit_anim"
            app:popEnterAnim="@anim/screen_pop_enter_anim"
            app:popExitAnim="@anim/screen_pop_exit_anim" />
    </fragment>
    <fragment
        android:id="@+id/premiumFragment"
        android:name="io.simplelogin.android.module.settings.PremiumFragment"
        android:label="PremiumFragment">
        <action
            android:id="@+id/action_premiumFragment_to_webViewFragment2"
            app:destination="@id/webViewFragment2"
            app:enterAnim="@anim/screen_enter_anim"
            app:exitAnim="@anim/screen_exit_anim"
            app:popEnterAnim="@anim/screen_pop_enter_anim"
            app:popExitAnim="@anim/screen_pop_exit_anim" />
    </fragment>
    <fragment
        android:id="@+id/webViewFragment2"
        android:name="io.simplelogin.android.module.about.WebViewFragment"
        android:label="WebViewFragment">
        <argument
            android:name="url"
            app:argType="string" />
    </fragment>
    <!--end:Settings fragments-->

    <fragment
        android:id="@+id/aboutFragment"
        android:name="io.simplelogin.android.module.about.AboutFragment"
        android:label="AboutFragment">
        <action
            android:id="@+id/action_aboutFragment_to_howItWorksFragment"
            app:destination="@id/howItWorksFragment"
            app:enterAnim="@anim/screen_enter_anim"
            app:exitAnim="@anim/screen_exit_anim"
            app:popEnterAnim="@anim/screen_pop_enter_anim"
            app:popExitAnim="@anim/screen_pop_exit_anim" />
        <action
            android:id="@+id/action_aboutFragment_to_faqFragment"
            app:destination="@id/faqFragment"
            app:enterAnim="@anim/screen_enter_anim"
            app:exitAnim="@anim/screen_exit_anim"
            app:popEnterAnim="@anim/screen_pop_enter_anim"
            app:popExitAnim="@anim/screen_pop_exit_anim" />
        <action
            android:id="@+id/action_aboutFragment_to_webViewFragment"
            app:destination="@id/webViewFragment"
            app:enterAnim="@anim/screen_enter_anim"
            app:exitAnim="@anim/screen_exit_anim"
            app:popEnterAnim="@anim/screen_pop_enter_anim"
            app:popExitAnim="@anim/screen_pop_exit_anim" />
        <action
            android:id="@+id/action_aboutFragment_to_whatYouCanDoFragment"
            app:destination="@id/whatYouCanDoFragment"
            app:enterAnim="@anim/screen_enter_anim"
            app:exitAnim="@anim/screen_exit_anim"
            app:popEnterAnim="@anim/screen_pop_enter_anim"
            app:popExitAnim="@anim/screen_pop_exit_anim" />
    </fragment>
    <fragment
        android:id="@+id/howItWorksFragment"
        android:name="io.simplelogin.android.module.about.HowItWorksFragment"
        android:label="HowItWorksFragment" />
    <fragment
        android:id="@+id/faqFragment"
        android:name="io.simplelogin.android.module.about.FaqFragment"
        android:label="FaqFragment" />
    <fragment
        android:id="@+id/whatYouCanDoFragment"
        android:name="io.simplelogin.android.module.about.WhatYouCanDoFragment"
        android:label="WhatYouCanDoFragment" />
</navigation>