<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.Material3.DynamicColors.DayNight">
        <!-- Customize your theme here. -->
        <item name="colorOutlineVariant">@color/md_theme_outlineVariant</item>

        <item name="windowNoTitle">true</item>

        <item name="buttonStyle">@style/SlButtonStyle</item>
        <item name="materialButtonStyle">@style/SlButtonStyle</item>
        <item name="textInputStyle">@style/SlTextInputOutlinedStyle</item>
        <item name="toolbarStyle">@style/SlToolbar</item>
        <item name="navigationViewStyle">@style/SlNavigationView</item>
    </style>

    <style name="HomeActivityTheme" parent="AppTheme">
        <item name="android:windowTranslucentStatus">false</item>
    </style>

    <style name="SlToolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">?colorPrimary</item>
    </style>

    <style name="SlButtonStyle" parent="Widget.Material3.Button">
        <item name="cornerRadius">4dp</item>
    </style>

    <style name="SlTextButtonStyle" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">4dp</item>
    </style>

    <style name="SlAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog" />

    <style name="SlTextInputOutlinedStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxBackgroundColor">?colorSurfaceContainer</item>
    </style>

    <style name="SlTextInputDropdownStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeColor">#0000</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxBackgroundColor">?colorSurfaceContainer</item>
    </style>

    <style name="SlSettingsItemTitle">
        <item name="android:textAppearance">?attr/textAppearanceListItem</item>
        <item name="singleLine">true</item>
        <item name="android:ellipsize">marquee</item>
    </style>

    <style name="SlSettingsItemSummary">
        <item name="android:textAppearance">?attr/textAppearanceListItemSecondary</item>
        <item name="android:maxLines">10</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">?android:textColorSecondary</item>
    </style>

    <style name="SlNavigationView" parent="Widget.Material3.NavigationView">
        <item name="materialThemeOverlay">@style/SlNavigationViewOverlay</item>
        <item name="android:background">?colorSurface</item>
        <item name="dividerInsetStart">0dp</item>
        <item name="dividerInsetEnd">0dp</item>
        <item name="drawerLayoutCornerSize">0dp</item>
    </style>

    <style name="SlNavigationViewOverlay" parent="">
        <item name="android:listDivider">?attr/colorOutlineVariant</item>
    </style>

    <style name="SlErrorButton" parent="Widget.Material3.Button.ElevatedButton">
        <item name="backgroundTint">?colorErrorContainer</item>
        <item name="android:textColor">?colorOnErrorContainer</item>
        <item name="cornerRadius">0dp</item>
        <item name="rippleColor">?colorControlHighlight</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>
