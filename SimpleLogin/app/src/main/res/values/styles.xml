<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.Material3.DynamicColors.DayNight">
        <!-- Customize your theme here. -->
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">?colorSurface</item>
        <item name="android:navigationBarColor">?colorSurface</item>

        <item name="buttonStyle">@style/SlButtonStyle</item>
        <item name="materialButtonStyle">@style/SlButtonStyle</item>
        <item name="textInputStyle">@style/SlTextInputOutlinedStyle</item>
    </style>

    <style name="HomeActivityTheme" parent="AppTheme">
        <item name="android:windowTranslucentStatus">false</item>
    </style>

    <style name="SlButtonStyle" parent="Widget.Material3.Button">
        <item name="cornerRadius">4dp</item>
    </style>

    <style name="SlTextButtonStyle" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">4dp</item>
    </style>

    <style name="SlAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog" />

    <style name="SlTextInputOutlinedStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxBackgroundColor">?colorSurfaceContainer</item>
    </style>
</resources>
