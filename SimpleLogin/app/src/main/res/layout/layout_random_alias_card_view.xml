<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="15dp">

        <TextView
            style="@style/SlSettingsItemTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/random_alias" />

        <TextView
            style="@style/SlSettingsItemSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:text="@string/random_alias_explication" />

        <Spinner
            android:id="@+id/random_mode_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginBottom="18dp"
            android:backgroundTint="?colorPrimary"
            android:spinnerMode="dropdown" />

        <TextView
            style="@style/SlSettingsItemSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:text="@string/domain_for_random_alias" />

        <Spinner
            android:id="@+id/default_domain_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginBottom="18dp"
            android:backgroundTint="?colorPrimary"
            android:spinnerMode="dropdown" />

    </LinearLayout>
</layout>